<!-- views/index.ejs -->
<!DOCTYPE html>
<html>

<head>
  <title><%= title %></title>
</head>

<body>
  <h1><%= title %></h1>
  <!-- In views/index.ejs -->
  <ul>
    <% if (locals.users) {%>
    <% users.forEach(function(user) { %>
    <li>
      <ul>
        <li>ID: <%= user.id %>, Name: <%= user.firstName %> <%= user.lastName %></li>
        <li>Email: <%= user?.email %></li>
        <li>Age: <%= user?.age %></li>
        <li>Bio: <%= user?.bio %></li>
        <li><a href="/<%= user.id %>/update">Update</a></li>
        <!-- <li>This time we're sending a POST request to our route, so we need a form.</li> -->
        <li>
          <form action="/<%= user.id %>/delete" method="POST" style="display:inline;">
            <button type="submit" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
          </form>
        </li>
      </ul>
    </li>
    <% }); %>
    <% } %>
  </ul>

  <a href="/create">Create a user</a>
</body>

</html>